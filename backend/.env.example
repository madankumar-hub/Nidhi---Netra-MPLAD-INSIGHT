# ---------------------------------------------------------------------------
# MPLAD Insight - Backend environment configuration (EXAMPLE)
# Copy to .env and fill in real values. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

APP_NAME="Nidhi Netra"
ENVIRONMENT=development
API_V1_PREFIX=/api

# --- Security -------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-generate-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- Database -------------------------------------------------------------
# PostgreSQL (recommended for production).
# Needs the optional driver:  pip install -r requirements-postgres.txt
# DATABASE_URL=postgresql+psycopg://mplad:CHANGE_ME@localhost:5432/mplad_insight
# SQLite (zero-config local development):
DATABASE_URL=sqlite:///./mplad_insight.db

# --- CORS -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Bootstrap accounts created by `python -m seed.seed_data` --------------
# Seeding refuses to run unless these are set. Never hardcode in source.
SEED_ADMIN_EMAIL=admin@mplad.gov.in
SEED_ADMIN_PASSWORD=
SEED_AUDITOR_EMAIL=auditor@mplad.gov.in
SEED_AUDITOR_PASSWORD=
SEED_OFFICER_EMAIL=officer@mplad.gov.in
SEED_OFFICER_PASSWORD=
SEED_CITIZEN_EMAIL=citizen@example.com
SEED_CITIZEN_PASSWORD=

# --- Deployment -----------------------------------------------------------
# Most cloud platforms inject PORT themselves; this is the local fallback.
PORT=8000
# Populate an empty database on first boot. Useful for a one-click cloud
# deploy so the site is never blank. Turn OFF once the data is in.
SEED_ON_STARTUP=false
SEED_ON_STARTUP_PROJECTS=400

# --- Official access control ----------------------------------------------
# Nobody can sign up as an official. Public sign-up always creates a Citizen;
# the Officer and Auditor roles are granted only when an Administrator
# approves a request. The Administrator role can never be requested at all.
#
# These settings control who may even SUBMIT a request.
# Comma-separated list of named addresses always allowed to request:
OFFICIAL_EMAIL_ALLOWLIST=
# Comma-separated domains treated as government addresses:
OFFICIAL_EMAIL_DOMAINS=gov.in,nic.in
# true  = a request from an address outside the list is refused outright
# false = anyone may request, and the Administrator decides on the merits
OFFICIAL_ALLOWLIST_ENFORCED=false

# --- Risk engine ----------------------------------------------------------
# The rule-based + statistical engine ALWAYS works with no external service.
# These only enable the OPTIONAL external-AI enhancement layer.
AI_ENHANCEMENT_ENABLED=false
AI_PROVIDER=anthropic           # anthropic | openai
AI_API_KEY=
AI_MODEL=claude-sonnet-4-5
AI_TIMEOUT_SECONDS=20

# The unsupervised anomaly model (isolation forest) is built in and always
# available once the database holds enough records - there is nothing to
# configure and no model file to ship.
#
# Duplicate-description detection backend: tfidf (built-in, no extra deps)
# or embeddings (requires `pip install sentence-transformers`).
DUPLICATE_BACKEND=tfidf
DUPLICATE_SIMILARITY_THRESHOLD=0.72

# --- OTP (citizen lightweight auth, FR1) ----------------------------------
# In development OTPs are returned in the API response / logged to console.
# In production wire OTP_DELIVERY=email to a real mail provider.
OTP_ENABLED=true
OTP_DELIVERY=console            # console | email
OTP_EXPIRY_MINUTES=10
